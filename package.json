{
    "name": "vessel",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "dev": "bun --bun vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "prepare": "svelte-kit sync || echo '' && simple-git-hooks",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "lint:audit": "bun audit",
        "build:standalone": "bun run scripts/build-standalone.ts",
        "clean": "rm -rf build"
    },
    "devDependencies": {
        "@fontsource-variable/inter": "^5.2.8",
        "@fontsource-variable/merriweather": "^5.2.6",
        "@internationalized/date": "^3.12.1",
        "@lucide/svelte": "^1.14.0",
        "@sveltejs/kit": "^2.59.1",
        "@sveltejs/vite-plugin-svelte": "^7.1.1",
        "@tailwindcss/vite": "^4.2.4",
        "@types/bcrypt": "^6.0.0",
        "@types/bcryptjs": "^2.4.6",
        "@types/bun": "^1.3.13",
        "@types/cookie": "^0.6.0",
        "@types/marked": "^6.0.0",
        "@types/pdfkit": "^0.17.6",
        "bits-ui": "^2.18.1",
        "clsx": "^2.1.1",
        "eslint-plugin-ai-guard": "^1.1.13",
        "eslint-plugin-jsdoc": "^62.9.0",
        "eslint-plugin-jwt": "^2.2.3",
        "eslint-plugin-secure-coding": "^3.1.3",
        "eslint-plugin-sonarjs": "^4.0.3",
        "get-tsconfig": "^4.14.0",
        "mode-watcher": "^1.1.0",
        "oxlint": "^1.63.0",
        "oxlint-tsgolint": "^0.22.1",
        "paneforge": "^1.0.2",
        "prettier": "^3.8.3",
        "prettier-plugin-svelte": "^3.5.1",
        "shadcn-svelte": "^1.2.7",
        "simple-git-hooks": "^2.13.1",
        "svelte": "^5.55.5",
        "svelte-adapter-bun": "^1.0.1",
        "svelte-check": "^4.4.8",
        "svelte-sonner": "^1.1.1",
        "tailwind-merge": "^3.5.0",
        "tailwind-variants": "^3.2.2",
        "tailwindcss": "^4.2.4",
        "tw-animate-css": "^1.4.0",
        "typescript": "^6.0.3",
        "vite": "^8.0.10"
    },
    "overrides": {
        "cookie": "^0.7.1",
        "ip-address": ">10.1.0",
        "@anthropic-ai/sdk": ">=0.91.1"
    },
    "simple-git-hooks": {
        "pre-push": "bun audit && bun run lint --quiet"
    },
    "dependencies": {
        "@codemirror/lang-markdown": "^6.5.0",
        "@codemirror/language-data": "^6.5.2",
        "@mariozechner/pi-agent-core": "^0.67.68",
        "@mariozechner/pi-ai": "^0.67.68",
        "@mariozechner/pi-coding-agent": "^0.67.68",
        "@speed-highlight/core": "^1.2.15",
        "bcrypt": "^6.0.0",
        "bcryptjs": "^3.0.3",
        "codemirror": "^6.0.2",
        "cookie": "^1.1.1",
        "d3-dag": "^1.2.1",
        "defuddle": "^0.18.1",
        "fflate": "^0.8.2",
        "happy-dom": "^20.9.0",
        "impit": "^0.14.0",
        "jose": "^6.2.3",
        "marked": "^18.0.3",
        "pdfkit": "^0.18.0",
        "pi-mcp-adapter": "^2.5.4",
        "svelte-streamdown": "^3.0.1",
        "zerobox": "^0.2.6",
        "zod": "^4.4.3"
    }
