{
    "lsp": {
        "eslint": {
            "settings": {
                "validate": "on",
                "packageManager": "npm"
            }
        },
        "vscode-css-language-server": {
            "settings": {
                "css": {
                    "lint": {
                        "unknownAtRules": "ignore",
                        "unknownProperties": "ignore"
                    }
                }
            }
        }
    },
    "tab_size": 4,
    "soft_wrap": "prefer_line",
    "preferred_line_length": 100,
    "format_on_save": "on",
    "formatter": "language_server",
    "languages": {
        "TypeScript": {
            "tab_size": 4,
            "formatter": "language_server"
        },
        "TSX": {
            "tab_size": 4,
            "formatter": "language_server"
        },
        "JavaScript": {
            "tab_size": 4,
            "formatter": "language_server"
        },
        "Svelte": {
            "tab_size": 4,
            "formatter": "language_server"
        },
        "HTML": {
            "tab_size": 4
        },
        "CSS": {
            "tab_size": 4
        },
        "JSON": {
            "tab_size": 4
        }
    }
}
